# Host-path configuration for running proofgatectl on the host.
server:
  addr: ":8080"
  admin_addr: "127.0.0.1:9090"

admin_auth:
  enabled: true
  max_login_attempts: 5
  lockout_duration: 15m
  session_idle_timeout: 30m
  session_absolute_timeout: 12h

secrets:
  kek: local
  local_kek_file: deploy/secrets/local_kek.b64

providers:
  - {name: mock-a, type: openai, base_url: "http://localhost:18081/v1", api_key_db: true}
  - {name: mock-b, type: openai, base_url: "http://localhost:18082/v1", api_key_db: true}
  - {name: openai, type: openai, base_url: "http://127.0.0.1:8317/v1", api_key_db: true}
  - {name: easycli, type: openai, base_url: "http://127.0.0.1:8317/v1", api_key_db: true}
  - {name: anthropic, type: anthropic, base_url: "https://api.anthropic.com", api_key_db: true}
  - {name: gemini, type: gemini, base_url: "https://generativelanguage.googleapis.com", api_key_db: true}
  - {name: ollama, type: openai, base_url: "http://localhost:11434/v1"}

pricing:
  mock-a/mock-small:   {input: 0.10, output: 0.40}
  mock-b/mock-large:   {input: 1.00, output: 4.00}
  mock-a/mock-embed:   {input: 0.02, output: 0}
  openai/gemini-3-flash: {input: 0.10, output: 0.40}
  openai/claude-sonnet-4-6: {input: 3.00, output: 15.00}
  openai/gpt-oss-120b-medium: {input: 0.20, output: 0.80}
  easycli/gemini-3-flash: {input: 0.10, output: 0.40}
  easycli/claude-sonnet-4-6: {input: 3.00, output: 15.00}

routes:
  - name: default
    targets:
      - {provider: openai, model: gemini-3-flash}
      - {provider: mock-a, model: mock-small}
    hedge: {enabled: true, max_extra: 0.1}
    cache:
      mode: on
      exact: true
      ttl: 24h
  - name: claude
    targets:
      - {provider: openai, model: claude-sonnet-4-6}
  - name: faq
    targets:
      - {provider: mock-a, model: mock-small}
      - {provider: mock-b, model: mock-large}
    cache:
      mode: on
      exact: true
      semantic: true
      threshold: 0.95
      embedding_route: embed
      ttl: 24h
  - name: embed
    embeddings: true
    targets:
      - {provider: mock-a, model: mock-embed}

slos:
  mock-a/mock-small: {ttft_ms: 800, max_error_rate: 0.2}
  mock-b/mock-large: {ttft_ms: 800, max_error_rate: 0.2}

health:
  alpha: 0.3
  breaches: 3
  recover: 30s
  min_samples: 10
  probe_interval: 5s
