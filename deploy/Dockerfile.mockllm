# Refresh digests with: docker buildx imagetools inspect golang:1.25 --format '{{json .Manifest.Digest}}'
FROM golang:1.27@sha256:3680233e3204827fbdc66088528ae6d4b3d034f51d03a99d454f6de034888244 AS build
WORKDIR /src
COPY . .
RUN if [ -f deploy/bin/mockllm ]; then \
      mkdir -p /out && cp deploy/bin/mockllm /out/mockllm; \
    else \
      go mod download && \
      CGO_ENABLED=0 GOFLAGS=-mod=readonly go build -trimpath -ldflags "-s -w" -o /out/mockllm ./cmd/mockllm; \
    fi

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/mockllm /usr/local/bin/mockllm
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/mockllm"]
