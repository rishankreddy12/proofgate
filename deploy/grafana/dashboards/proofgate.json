{
  "uid": "proofgate",
  "title": "ProofGate",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests/s by status", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "expr": "sum by (status) (rate(proofgate_requests_total[1m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "Gateway overhead p50 / p99 (ms)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [
       {"refId": "A", "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(proofgate_overhead_seconds_bucket[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(proofgate_overhead_seconds_bucket[5m])))", "legendFormat": "p99"}]},
    {"id": 3, "type": "timeseries", "title": "Cache hit rate (chat)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"},
     "targets": [{"refId": "A", "editorType": "sql", "format": 0, "queryType": "timeseries",
       "rawSql": "SELECT $__timeInterval(ts) AS time, countIf(cache = 'hit-exact') / count() AS exact, countIf(cache = 'hit-semantic') / count() AS semantic FROM usage_events WHERE $__timeFilter(ts) AND kind = 'chat' GROUP BY time ORDER BY time"}]},
    {"id": 4, "type": "stat", "title": "Net cache savings (USD, range)", "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
     "datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"},
     "targets": [{"refId": "A", "editorType": "sql", "format": 1, "queryType": "table",
       "rawSql": "SELECT (sumIf(saved_micros, kind = 'chat') - sumIf(cost_micros, kind = 'cache_embed')) / 1e6 AS net_usd FROM usage_events WHERE $__timeFilter(ts)"}]},
    {"id": 5, "type": "table", "title": "Spend by tenant (USD, range)", "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
     "datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"},
     "targets": [{"refId": "A", "editorType": "sql", "format": 1, "queryType": "table",
       "rawSql": "SELECT tenant_id, sum(cost_micros) / 1e6 AS usd, count() AS requests FROM usage_events WHERE $__timeFilter(ts) GROUP BY tenant_id ORDER BY usd DESC LIMIT 20"}]},
    {"id": 6, "type": "timeseries", "title": "Errors/s by target", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"refId": "A", "expr": "sum by (target, status) (rate(proofgate_requests_total{status!=\"ok\"}[1m]))", "legendFormat": "{{target}} {{status}}"}]}
  ]
}
